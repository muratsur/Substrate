; BP_GrowthNode: advance one stage per round, only while unobserved (DESIGN.md section 4)
(event EventBeginPlay
  (Variables|Default|SetEligibleThisRound true)
  (Utilities|Time|SetTimerbyFunctionName :Object self :FunctionName "CheckObserved" :Time 0.2 :bLooping true))

(fn CheckObserved ()
  (if (Variables|Default|GetEligibleThisRound)
    (if (Rendering|WasActorRecentlyRendered self)
      (Variables|Default|SetUnobservedTime 0.0)
      (else
        (bind t (+ (Variables|Default|GetUnobservedTime) 0.2))
        (Variables|Default|SetUnobservedTime t)
        (if (>= t (Variables|Default|GetSecondsToAdvance))
          (bind stages (Variables|Default|GetGrowthStages))
          (bind idx (Variables|Default|GetStageIndex))
          (if (Utilities|Array|IsValidIndex stages idx)
            (bind mesh (Utilities|Array|Get(acopy) stages idx))
            (Components|StaticMesh|SetStaticMesh (Variables|Default|GetStaticMeshComponent) mesh)
            (bind scales (Variables|Default|GetGrowthScales))
            (if (Utilities|Array|IsValidIndex scales idx)
              (bind s (Utilities|Array|Get(acopy) scales idx))
              (Transformation|SetActorScale3D self (Math|Vector|MakeVector :X s :Y s :Z s)))
            (Variables|Default|SetStageIndex (+ idx 1))
            (Variables|Default|SetEligibleThisRound false)
            (Variables|Default|SetUnobservedTime 0.0)))))))
